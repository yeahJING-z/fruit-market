<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.fruitmarket.mapper.MemberMapper">

    <select id="getById" resultType="com.example.fruitmarket.entity.Member">
        SELECT * FROM member WHERE member_id = #{memberId}
    </select>

    <select id="findByPhone" resultType="com.example.fruitmarket.entity.Member">
        SELECT * FROM member WHERE phone = #{phone}
    </select>

    <update id="addPoints">
        UPDATE member
        SET points_balance = points_balance + #{points}
        WHERE member_id = #{memberId}
    </update>

</mapper>
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.fruitmarket.mapper.OrderItemMapper">

    <insert id="insert">
        INSERT INTO order_item (order_id, product_id, quantity, unit_price, subtotal)
        VALUES (#{orderId}, #{productId}, #{quantity}, #{unitPrice}, #{subtotal})
    </insert>

    <select id="listByOrderId" resultType="com.example.fruitmarket.entity.OrderItem">
        SELECT * FROM order_item WHERE order_id = #{orderId}
    </select>

</mapper>